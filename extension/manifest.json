{
  "manifest_version": 3,
  "name": "Ghost-Prime Browser Bridge",
  "version": "1.1.0",
  "description": "Lets the Ghost-Prime app drive this Chrome — navigate, click, fill, read, and screenshot — over a local 127.0.0.1 connection.",
  "permissions": ["tabs", "scripting", "activeTab", "storage", "alarms", "contextMenus", "tabGroups", "debugger", "sidePanel"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "<all_urls>"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "128": "icon-128.png" },
  "action": { "default_title": "Ghost-Prime — open chat side panel", "default_icon": "icon-128.png" }
}
