<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GHOST-PRIME"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textColor="#00E6FF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="Phone connector"
            android:textColor="#9FB0D6" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:background="#141A2A"
            android:text="Not connected"
            android:textColor="#EEF2FF" />

        <Button
            android:id="@+id/pastePair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paste pairing link" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Easiest: in Ghost-Prime open Settings → Pair your phone and scan the QR with the camera. Or fill in the fields below."
            android:textColor="#9FB0D6"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bridge host — your computer's IP (e.g. 192.168.1.20)"
            android:inputType="text"
            android:autofillHints="" />

        <EditText
            android:id="@+id/port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Port"
            android:inputType="number"
            android:text="8731"
            android:autofillHints="" />

        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Shared token"
            android:inputType="text"
            android:text="ghost-local"
            android:autofillHints="" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Save &amp; (re)connect" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#22304A" />

        <Button
            android:id="@+id/accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 · Enable Accessibility" />

        <Button
            android:id="@+id/screen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2 · Grant screen capture" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3 · Start connector" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop connector" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="12sp"
            android:textColor="#61719A"
            android:text="Open the Ghost-Prime app on your computer, set Bridge host to its IP (same Wi-Fi), enable the three permissions above, then Start. This phone will appear as a named device in the app." />
    </LinearLayout>
</ScrollView>
