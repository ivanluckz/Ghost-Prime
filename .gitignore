# Secrets — never commit (.env.* also catches .env.save / .env.bak copies)
.env
.env.*
!.env.example
jarvis/config/api_keys.json

# Dependencies / build output
node_modules/
dist/
out/
*.log

# Large vendored / downloaded binaries (regenerable, not source)
vendor/
daemon/.venv/
daemon/model/
.venv/
__pycache__/

# Local tooling state
.claude/
.cursor/
.agents/

# Scratch field for the next commit message (push-after-build reads + clears it)
COMMIT_MSG.txt

# Android connector — build outputs + machine-specific SDK path (regenerable)
android-connector/.gradle/
android-connector/build/
android-connector/app/build/
android-connector/local.properties
android-connector/.kotlin/

# Generated next to the DEPLOYED extension only (holds the bridge token); never inside extension/
extension/bridge-config.json
