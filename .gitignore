# Secrets — never commit
.env
.env.local

# Dependencies / build output
node_modules/
dist/
out/
*.log

# Large vendored / downloaded binaries (regenerable, not source)
vendor/
daemon/.venv/
daemon/model/
.venv/
__pycache__/

# Big generated media
assets/intro.mp4

# Local tooling state
.claude/
.cursor/
.agents/

# Scratch field for the next commit message (push-after-build reads + clears it)
COMMIT_MSG.txt
