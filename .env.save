# --- Ghost-Prime brain ---
# Provider: claude-agent | gemini | openrouter   (switch the brain by changing this one line)
# Default is claude-agent (real Claude on your Pro login). If Claude is out of credits /
# rate-limited, Ghost-Prime auto-falls back to GHOST_FALLBACK_PROVIDER for that one reply,
# then returns to Claude on the next message. Set GHOST_PROVIDER=openrouter to force the backup.
GHOST_PROVIDER=claude-agent
GHOST_FALLBACK_PROVIDER=openrouter

# --- OpenRouter (used when GHOST_PROVIDER=openrouter) ---
# Key at https://openrouter.ai/keys
OPENROUTER_API_KEY=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
#   Free (rate-limited): openai/gpt-oss-120b:free  (verified)
#   Claude (needs credits): anthropic/claude-opus-4.8  (or a cheaper claude-sonnet/haiku)
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# --- Gemini (brain when GHOST_PROVIDER=gemini, AND natural voice in/out) ---
# Google AI Studio FREE tier, no billing — get a key at https://aistudio.google.com/apikey
# Paste the key below. It powers two things, independently:
#   • the chat brain — only when GHOST_PROVIDER=gemini above
#   • VOICE — transcription + natural spoken replies — whenever this key is set (any brain)
GEMINI_API_KEY=AQ.Ab8RN6Lg8It4Gi84yxfleyxHwMRHb6VUM5KiI1CWyh1zGTL_-Q
GEMINI_MODEL=gemini-2.5-flash

# --- Voice (speech in/out) ---
# Backend: 'gemini' = Google's natural neural voices (needs GEMINI_API_KEY); 'local' = offline
# Whisper + Piper/espeak. Default: gemini when a key is set, else local. Falls back to local on
# any Gemini error (no key / network / quota).
GHOST_VOICE_PROVIDER=gemini
# Spoken-reply voice — one of: Kore, Puck, Charon, Zephyr, Fenrir, Leda, Aoede, Achernar, … (30 total)
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_STT_MODEL=gemini-2.5-flash

# --- Claude Agent (used when GHOST_PROVIDER=claude-agent) ---
# Real Claude via @anthropic-ai/claude-agent-sdk on your Claude Code login — no API key.
# Uses your Pro plan's ~$20/mo Agent SDK credit; keep "usage credits" OFF and it
# just pauses when spent (never charges). Already logged into Claude Code -> works now.
# Pin a STANDARD-context model: 1M-context modes require usage credits.
# Portable/headless token (optional): run `claude setup-token` and it persists ~1 year.
# Model: sonnet = balanced & reliable for agentic/browser tasks (default); opus = most capable
# (spends allotment fastest); haiku = cheap & fast but weak at multi-step tool use. Aliases
# auto-map to the latest of each tier (sonnet→Sonnet 4.6, opus→Opus 4.8, haiku→Haiku 4.5).
CLAUDE_AGENT_MODEL=sonnet
# Response speed vs depth. effort: low = snappy (default); medium/high/xhigh/max = more thorough
# but slower. (Ignored for haiku, which doesn't support effort.) Set CLAUDE_AGENT_THINKING=off for
# the fastest possible first token; leave 'adaptive' for balanced quality.
CLAUDE_AGENT_EFFORT=low
CLAUDE_AGENT_THINKING=adaptive

# --- Browser control ---
# Backend: 'auto' (default) drives your REAL Chrome via the bridge extension when it's connected,
# else falls back to Playwright. Force with 'extension' or 'playwright'.
GHOST_BROWSER_BACKEND=auto
# If your Chrome is closed when a browser task starts, open it so the extension can attach and
# drive it. Set to false to never auto-open Chrome. GHOST_CHROME_BIN overrides which binary to launch.
GHOST_BROWSER_AUTOLAUNCH=true
# GHOST_CHROME_BIN=google-chrome
# Local bridge the Chrome extension connects to (loopback only). These MUST match the values set
# in the extension's options page. Change the token to something private if you like.
GHOST_BRIDGE_PORT=8731
GHOST_BRIDGE_TOKEN=ghost-local
# Bind address. 127.0.0.1 = only the Crostini Linux Chrome can reach the bridge. Set 0.0.0.0 to also
# let your Chrome OS HOST browser reach it — then set the extension's "Bridge host" option to
# penguin.linux.test (its Host field, in the extension's options page).
GHOST_BRIDGE_HOST=0.0.0.0
# Dev only: when the extension's files change, auto-tell it to reload (chrome.runtime.reload re-reads
# from disk) — no manual chrome://extensions reload. Leave off for a packaged build.
GHOST_EXT_AUTORELOAD=1
# Survive restarts: mirror the extension into a Chrome OS↔Linux SHARED folder and load it from THERE
# in chrome://extensions (a ~/Projects path vanishes for the host browser when Crostini is off).
# Pointed at your shared Docs folder. Leave blank to load straight from this project's extension/.
GHOST_EXT_DEPLOY=/mnt/chromeos/shared/MyFiles/Docs/ghost-prime-extension

# --- Display / performance ---
# GPU acceleration (needs "GPU support" enabled in chrome://flags on Crostini). Makes the glass
# blur + animations smooth. If the window black-screens or crash-loops on launch, set to 'off'.
GHOST_GPU=on
# Display server: wayland (default — crisp, fractional scaling) | x11 (XWayland) | auto.
# If mouse clicks stop working on Wayland (frameless quirk), use x11, or set GHOST_NATIVE_FRAME=1.
GHOST_OZONE=wayland

# --- Higgsfield (intro generation; the app uses OAuth via MCP, these are unused at runtime) ---
HIGGSFIELD_API_KEY_ID=721b596f-42a5-49b6-b726-d8ac67d124d1
HIGGSFIELD_API_KEY_SECRET=1db4d7e2abb0ef9f7d213afd4f4af60b734c285874348ac1577c3282cb71f115

# --- Discord bot (Ghost-Prime relay) — bot is online only while Ghost-Prime runs ---
# Bot token from the Discord Developer Portal (your app → Bot → Reset/Copy Token). Required to enable.
DISCORD_BOT_TOKEN=MTUxODMyNTkwMjA4MDIxNzEwOA.GCw4tJ.NKCFeM65AOIz0GfA0FWw1O3KlkucDFSm6tMQrE
# Comma-separated Discord USER IDs allowed to control Ghost (REQUIRED — without it the bot ignores everyone).
# Get your id: Discord → User Settings → Advanced → Developer Mode ON, then right-click yourself → Copy User ID.
DISCORD_ALLOWED_USER_IDS=1337125751853420615
# Optional: also respond in this one channel id (besides DMs). Leave blank for DMs only.
DISCORD_CHANNEL_ID=
# Autonomy for Discord requests: plan | auto | full  (auto = classifier-gated; full = no checks — careful)
DISCORD_MODE=auto
