[Unit]
Description=Ghost-Prime wake-word listener (always-on, starts with Crostini)
After=default.target

[Service]
ExecStart=%h/Projects/Ghost-Prime/daemon/.venv/bin/python %h/Projects/Ghost-Prime/daemon/wake.py
Restart=always
RestartSec=3
# Defaults match the app's .env. Uncomment + edit if you changed them:
# Environment=GHOST_WAKE_PHRASE=ghost
# Environment=GHOST_BRIDGE_TOKEN=ghost-local
# Environment=GHOST_LAUNCH_CMD=gtk-launch ghost-prime

[Install]
WantedBy=default.target
